#!/bin/bash
set -o pipefail

${DEBUG:+eval $(debugtrace -o $- -- "$@")}

printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, she can
    # skim the long one.
    printf 'Usage: [TMUX_LESS_LINES=N] %q %s\n' "$(basename "$1")" '[-l|--lines N|-L|--no-lines] [-s|--size N|P%] [(-d|--directory DIRSPEC|--clipboard|--inbox) [-N|--command-name CN|-n|--name NAME|FILESPEC|--no-interpreter] [-a|--append]] [--] [shell-command] [-?|-h|--help]'
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Run shell-command / a new shell in a vertically split new pane (when running in
tmux) that (during the runtime of the command) takes up almost all the space of
the current tmux pane, and wait for its completion.
Leading and trailing output from that new pane will be copied to the current
pane, so that an excerpt of the command's output (or even its entirety if small
enough) is kept (and the remainder available via a capture file), but only so
much that it fits the terminal height.
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    cat <<HELPTEXT
    --lines|-l N	Show N lines of output in the current pane (default: as
			many that fit the terminal height).
    --no-lines|-L	Don't show any output from shell-command in the current
			pane after it exits.
    --size|-s N		Set the height of the split pane to N lines (default:
			100%)
    --size|-s P%	Set the height of the split pane to P percent of the
			available space (default: 100%)
    --directory|-d DIRSPEC
			Use DIRSPEC for the capture file (default: recall
			through smartless).
    --clipboard		Store the command's output in the system clipboard
			(default: recall through smartless). Implies --no-lines.
    --inbox		Use the special inbox command to store the command's
			output (default: recall through smartless). Implies
			--no-lines.
    --name|-n NAME	Use NAME instead of generating one from the command
			itself with an added timestamp.
    --name|-n FILESPEC	Capture to FILESPEC (combined with to DIRSPEC if given).
    --command-name|-N CN
			Override just the command name; unlike --name, this
			still adds the timestamp to it.
    --no-interpreter	Drop a generic interpreter (bash, perl, python, etc.)
			from a name that is derived from COMMAND.
    --append|-a		Append to file / clipboard.

EXIT STATUS:
    *	Any exit status from shell-command.
HELPTEXT
}

isShowCapture=t
setLines()
{
    local lineNum="${1:?}"; shift
    if [ $lineNum -eq 0 ]; then
	isShowCapture=
    else
	export SMARTLESS_NUM_LINES=$lineNum
    fi
}
[ -n "$TMUX_LESS_LINES" ] && setLines "$TMUX_LESS_LINES"

splitHeight=100%
dirspec=
captureName=
commandName=
typeset -a commandNameArgs=()
isAppend=
target=
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;

	--lines|-l)	shift; setLines "${1:?}"; shift;;
	--no-lines|-L)	shift; setLines 0;;
	--size|-s)	shift; splitHeight="${1:?}"; shift;;

	--clipboard)	shift
			if [ -n "$target" ]; then
			    echo >&2 "ERROR: Cannot combine --clipboard with --$target"
			    exit 2
			fi
			target=clipboard
			;;
	--directory|-d)	shift; dirspec="${1%%/}/"; shift;;
	--inbox)	shift
			if [ -n "$target" ]; then
			    echo >&2 "ERROR: Cannot combine --clipboard with --$target"
			    exit 2
			fi
			target=inbox
			;;
	--name|-n)	shift; captureName="$1"; shift;;
	--command-name|-N)
			shift; commandName="$1"; shift;;
	--no-interpreter)
			commandNameArgs+=("$1"); shift;;
	--append|-a)	shift; isAppend=t;;

	--)		shift; break;;
	-*)		{ echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		break;;
    esac
done
if [ -n "$target" -a "$dirspec" ]; then
    echo >&2 "ERROR: Cannot combine --$target with --directory."
    exit 2
elif [ "$target" = clipboard  ] && [ -n "$captureName" ]; then
    echo >&2 "ERROR: Cannot specify both --$target and --name!"
    exit 2
fi

if [ -z "$TMUX" ]; then
    echo >&2 'ERROR: Not in a tmux session.'
    exit 1
fi

case $# in
    0)	set -- "$(tmux show-options -Aqv default-shell)";;
    # tmux takes a single argument as a COMMAND-LINE, and multiple arguments as a SIMPLECOMMAND.
    1)	quotedCommandLine="$1";;
    *)	printf -v quotedCommandLine ' %q' "$@";;
esac

# Use a separate file to transfer the exit status of the new shell back to this script.
statusFilespec="$(mktemp --tmpdir "$(basename -- "$0")-XXXXXX" 2>/dev/null || echo "${TMPDIR:-/tmp}/$(basename -- "$0").$$$RANDOM")"
printf -v quotedStatus 'echo $? > %q' "$statusFilespec"

capture=
captureFilespec=
if [ -n "$target" -o -n "$dirspec" ]; then
    if [ "$target" = clipboard ]; then
	capture="| ${target}${isAppend:+ --append}"
    else
	if [ -n "$captureName" ]; then
	    targetNameArg=--name
	else
	    targetNameArg=--unlocalized-name
	    [ -n "$commandName" ] || commandName="$(commandName --no-include-files --no-include-subcommands "${commandNameArgs[@]}" --eval "${quotedCommandLine# }")"
	    dateFormat='+%Y%m%d-%H%M%S'
	    [ "$isAppend" ] && dateFormat='+%Y%m%d' # Appending to a file name that has a timestamp with seconds precision doesn't make much sense. Instead, use a separate timestamp only each day. Users can tweak this with --name, anyway.
	    captureName="$(basename "${commandName:-capture}")_$(date "$dateFormat")"
	fi

	if [ -n "$target" ]; then
	    printf -v capture '| %s %q' "${target}${isAppend:+ --append}${targetNameArg:+ }${targetNameArg}" "$captureName"
	else
	    captureFilespec="${dirspec}${captureName}"
	    printf -v capture '>%s%q' "${isAppend:+>}" "$captureFilespec"
	fi
    fi
else
    # Capture as a smartless file, so that it can be recalled via its
    # smartless-recall command.
    captureFilespec="$(smartless --get-filespec)" || exit 3
    printf -v capture '>%q' "$captureFilespec"
fi

if [ "$isShowCapture" ] || [ -n "$capture" ]; then
    # When the new shell exits, capture its exit status, the pane's output, and then wake up this script.
    # Short command outputs will have trailing empty lines to fill up the pane's
    # height; remove those and any trailing whitespace in general.
    printf -v trapCommand 'trap %q\;\ tmux\ capture-pane\ -t\ "$(tmux display-message -p "#{pane_id}")"\ %q EXIT' \
	    "$quotedStatus" \
	    "-J -S - -p | truncate-trailing ${capture}; kill -SIGUSR1 $$"
else
    # When the new shell exits, capture its exit status, and then wake up this script.
    printf -v trapCommand 'trap %q\;\ %q EXIT' \
	    "$quotedStatus" \
	    "kill -SIGUSR1 $$"
fi

# When we're outputting the head and tail of the pane's output, the enlargement
# of the original pane may not yet have been reflected in the $LINES variable.
# Save it so that we can override the value in the smartless invocation.
originalLines=$LINES
onCompletion()
{
    < "$statusFilespec" read -r status
    ${DEBUG:+debugcommand --} rm -f -- "$statusFilespec" 2>/dev/null
    [ -z "$captureFilespec" ] || LINES=$originalLines smartless --truncate-only "$captureFilespec"
    kill %% 2>/dev/null	# Stop the sleep job that kept this script running.
    exit ${status:-3}
}
trap onCompletion SIGUSR1

customExports="$(! ${DEBUG:+debugenabled --invert-match --extension \! --module customExports --} ${DEBUG:-:} || customExports --ignore-undefined --prefix '-e ' | tr $'\n' ' ')"
eval "tmux split-window -l \$splitHeight -v $customExports" '-c "#{pane_current_path}" "${trapCommand};${quotedCommandLine}"'

sleep infinity & wait	# The new tmux pane command runs asynchronously; we need to wait until we're informed about its exit.
